# Copy this file to apps/web/.env and fill in real values.
# Never commit apps/web/.env.

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development

# --- Database (PostgreSQL) ---------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/curio

# --- Better Auth -------------------------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-at-least-32-characters
# Must match the URL the app is served from.
BETTER_AUTH_URL=http://localhost:3001

# --- AI model (OpenAI or any OpenAI-compatible gateway) ------------------------
# OpenCode Go example: https://opencode.ai/zen/go/v1
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=replace-with-your-api-key
AI_MODEL=gpt-4o-mini
# "chat-completions" for OpenAI-compatible gateways (GLM, Kimi, DeepSeek, ...)
# "responses" for gateways that expose the OpenAI Responses API.
AI_PROTOCOL=chat-completions

# --- Artifact Server (optional) ----------------------------------------------
# When unset, create_artifact is disabled and no publish flow is offered.
# ARTIFACT_SERVER_URL=http://127.0.0.1:8787/mcp
# ARTIFACT_SERVER_API_KEY=

# --- Web reading (optional) ---------------------------------------------------
# Obscura renders JavaScript-heavy pages for the web_read tool. Without it,
# web_read explains that the binary is missing; web_search still works.
# OBSCURA_BIN=obscura
# OBSCURA_STEALTH=0

{
  "name": "curio",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "vp run -r dev",
    "build": "vp run -r build",
    "check-types": "vp run -r check-types",
    "check": "ultracite check && vp run -r check-types",
    "lint": "oxlint",
    "format": "oxfmt",
    "test": "vitest run --exclude \"artifact-server/**\"",
    "test:watch": "vitest --exclude \"artifact-server/**\"",
    "test:coverage": "vitest run --coverage --exclude \"artifact-server/**\"",
    "staged": "vp staged",
    "hooks:setup": "vp config",
    "dev:web": "vp run --filter web dev",
    "db:push": "vp run --filter @curio/db db:push",
    "db:studio": "vp run --filter @curio/db db:studio",
    "db:generate": "vp run --filter @curio/db db:generate",
    "db:migrate": "vp run --filter @curio/db db:migrate",
    "auth:generate": "cd apps/web && pnpm run auth:generate",
    "fix": "ultracite fix"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@curio/config": "workspace:*",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.4.1",
    "@vitest/coverage-v8": "^5.1.0",
    "happy-dom": "^21.0.4",
    "jsdom": "^30.1.2",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "rolldown": "1.2.7",
    "typescript": "catalog:",
    "ultracite": "7.12.4",
    "vite-plus": "0.3.1",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@11.8.0"
}
